{
  "name": "synra",
  "version": "0.0.8",
  "description": "The aggregate type surface for Synra plugin authors. Zero runtime; usually resolved transitively.",
  "license": "MIT",
  "homepage": "https://github.com/synra-rs/synra-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synra-rs/synra-js.git",
    "directory": "packages/synra"
  },
  "bugs": {
    "url": "https://github.com/synra-rs/synra-js/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "!dist/.tsbuildinfo"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@synra/client": "workspace:^",
    "@synra/protocol": "workspace:^",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}