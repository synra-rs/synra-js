{
  "name": "@synra/testkit",
  "version": "0.1.0",
  "description": "A fake Synra client for plugin authors: run a plugin's UI without the host.",
  "license": "MIT",
  "homepage": "https://github.com/synra-rs/synra-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synra-rs/synra-js.git",
    "directory": "packages/testkit"
  },
  "bugs": {
    "url": "https://github.com/synra-rs/synra-js/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "!dist/.tsbuildinfo"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.mjs",
  "main": "./dist/index.mjs",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@synra/client": "workspace:^",
    "@synra/protocol": "workspace:^",
    "synra": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}