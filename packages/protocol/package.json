{
  "name": "@synra/protocol",
  "version": "0.1.0",
  "description": "Synra wire protocol types. Generated from the Rust kernel; do not edit by hand.",
  "license": "MIT",
  "homepage": "https://github.com/synra-rs/synra-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synra-rs/synra-js.git",
    "directory": "packages/protocol"
  },
  "bugs": {
    "url": "https://github.com/synra-rs/synra-js/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "!dist/.tsbuildinfo"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "sync": "tsx ../../scripts/gen-protocol-types.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}